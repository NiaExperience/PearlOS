#!/usr/bin/env python3
"""Show one PearlOS background task for operator debugging."""
from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.error
import urllib.request


def _load_secret() -> str:
    secret = os.getenv("BOT_CONTROL_SHARED_SECRET", "").strip()
    if secret:
        return secret
    for path in (
        "/workspace/nia-universal/.env.local",
        "/workspace/nia-universal/.env",
        "/home/deploy/pearlos/.env.local",
        "/home/deploy/pearlos/.env",
    ):
        try:
            with open(path, "r", encoding="utf-8") as handle:
                for line in handle:
                    key, sep, value = line.strip().partition("=")
                    if sep and key == "BOT_CONTROL_SHARED_SECRET":
                        return value.strip().strip('"').strip("'")
        except Exception:
            continue
    for path in (
        "/root/.openclaw/openclaw.json",
        "/home/deploy/.openclaw/relay-openclaw.json",
    ):
        try:
            with open(path, "r", encoding="utf-8") as handle:
                cfg = json.load(handle)
            token = (
                cfg.get("env", {}).get("BOT_CONTROL_SHARED_SECRET")
                or cfg.get("gateway", {}).get("auth", {}).get("token")
                or cfg.get("env", {}).get("OPENCLAW_GATEWAY_TOKEN")
            )
            if token:
                return str(token)
        except Exception:
            continue
    return ""


def _headers() -> dict[str, str]:
    headers = {"Accept": "application/json"}
    secret = _load_secret()
    if secret:
        headers["Authorization"] = f"Bearer {secret}"
        headers["X-Bot-Secret"] = secret
    return headers


def main() -> int:
    parser = argparse.ArgumentParser(prog="pearl-task-show")
    parser.add_argument("task_id")
    args = parser.parse_args()

    base = os.getenv("PEARL_TASKS_API", "http://127.0.0.1:4444/api/tasks").rstrip("/")
    try:
        req = urllib.request.Request(f"{base}/{args.task_id}", headers=_headers())
        with urllib.request.urlopen(req, timeout=15) as resp:
            payload = json.loads(resp.read().decode("utf-8"))
    except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError) as exc:
        print(f"Failed to show task: {exc}", file=sys.stderr)
        return 1

    task = payload.get("task", payload)
    print(json.dumps(task, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
