#!/usr/bin/env python3
"""Small CLI for Claude worker tasks.

Usage:
  pearl-task complete <task_id> --result "summary"
  pearl-task fail <task_id> --error "what blocked it"
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.request


def _load_secret() -> str:
    # The tasks API (:4444) validates against BOT_CONTROL_SHARED_SECRET, so
    # prefer that env var when present. The config-file gateway tokens below are
    # a separate relay secret and can drift out of sync with the API's secret,
    # which previously caused 401s on task completion.
    env_secret = os.getenv("BOT_CONTROL_SHARED_SECRET", "")
    if env_secret:
        return env_secret
    for path in (
        "/workspace/nia-universal/.env.local",
        "/workspace/nia-universal/.env",
        "/home/deploy/pearlos/.env.local",
        "/home/deploy/pearlos/.env",
    ):
        try:
            with open(path, "r", encoding="utf-8") as handle:
                for line in handle:
                    key, sep, value = line.strip().partition("=")
                    if sep and key == "BOT_CONTROL_SHARED_SECRET":
                        return value.strip().strip('"').strip("'")
        except Exception:
            continue
    for path in (
        "/root/.openclaw/openclaw.json",
        "/home/deploy/.openclaw/relay-openclaw.json",
    ):
        try:
            with open(path, "r", encoding="utf-8") as handle:
                cfg = json.load(handle)
            token = (
                cfg.get("env", {}).get("BOT_CONTROL_SHARED_SECRET")
                or cfg.get("gateway", {}).get("auth", {}).get("token")
                or cfg.get("env", {}).get("OPENCLAW_GATEWAY_TOKEN")
            )
            if token:
                return str(token)
        except Exception:
            continue
    return ""


def _patch(task_id: str, body: dict) -> None:
    base = os.getenv("PEARL_TASKS_API", "http://127.0.0.1:4444/api/tasks").rstrip("/")
    secret = _load_secret()
    headers = {
        "Accept": "application/json",
        "Content-Type": "application/json",
    }
    if secret:
        headers["X-Bot-Secret"] = secret
        headers["Authorization"] = f"Bearer {secret}"
    req = urllib.request.Request(
        f"{base}/{task_id}",
        method="PATCH",
        data=json.dumps(body).encode("utf-8"),
        headers=headers,
    )
    with urllib.request.urlopen(req, timeout=10) as resp:
        sys.stdout.write(resp.read().decode("utf-8"))
        sys.stdout.write("\n")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="pearl-task")
    sub = parser.add_subparsers(dest="command", required=True)

    complete = sub.add_parser("complete")
    complete.add_argument("task_id")
    complete.add_argument("--result", required=True)
    complete.add_argument("--note", default="")

    fail = sub.add_parser("fail")
    fail.add_argument("task_id")
    fail.add_argument("--error", required=True)
    fail.add_argument("--note", default="")
    fail.add_argument("--no-retry", action="store_true")

    args = parser.parse_args(argv)
    if args.command == "complete":
        body = {"status": "completed", "result": args.result}
        if args.note:
            body["note"] = args.note
    else:
        body = {"status": "failed", "result": args.error}
        if args.note:
            body["note"] = args.note
        if args.no_retry:
            body["no_retry"] = True
    _patch(args.task_id, body)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
