#
# Nia Universal - Legacy full env template (SANITIZED)
#
# IMPORTANT:
# - This file intentionally contains **NO real secrets** and **NO AWS hostnames**.
# - Prefer the minimal standalone template for local dev:
#     cp config/env.minimal.example .env.local
#
# If you *do* need cloud integrations, fill values locally in `.env.local` (never commit).
#

# === DATABASE (Local) ===
POSTGRES_DB=testdb
POSTGRES_HOST=localhost
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432
POSTGRES_USER=postgres

# === AUTH (Local) ===
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_INTERFACE_URL=http://localhost:3000
NEXTAUTH_DASHBOARD_URL=http://localhost:4000

# === DATA LAYER ===
MESH_ENDPOINT=http://localhost:2000/graphql
# Generate with: openssl rand -base64 32
MESH_SHARED_SECRET=

# === TOKEN ENCRYPTION ===
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
FORCE_ENCRYPTION=false

# === FEATURE FLAGS / DEBUG ===
DISABLE_CACHE=false
DEBUG_CACHE=false
DEBUG_TEST=false
PERF_MONITOR=false
LOG_LEVEL=info

# === OPTIONAL: Voice / AI (External APIs) ===
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY_SECONDARY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
YOUTUBE_API_KEY=
DAILY_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# === OPTIONAL: Google OAuth (External) ===
GOOGLE_INTERFACE_CLIENT_ID=
GOOGLE_INTERFACE_CLIENT_SECRET=
GOOGLE_DASHBOARD_CLIENT_ID=
GOOGLE_DASHBOARD_CLIENT_SECRET=

# === OPTIONAL: Email ===
EMAIL_FROM=noreply@localhost
EMAIL_REQUIRE_SES=false
EMAIL_FORCE_SES=false

# === OPTIONAL: Twilio ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
NEXT_PUBLIC_TWILIO_ACCOUNT_SID=
NEXT_PUBLIC_TWILIO_AUTH_TOKEN=

# === OPTIONAL: Redis ===
USE_REDIS=false
REDIS_URL=redis://localhost:6379
REDIS_AUTH_REQUIRED=false
REDIS_SHARED_SECRET=

# === OPTIONAL: Bot control ===
BOT_CONTROL_AUTH_REQUIRED=0
BOT_CONTROL_SHARED_SECRET=
NEXT_PUBLIC_PASSWORD_PROTECTION=false

# === OPTIONAL: Analytics ===
NEXT_PUBLIC_POSTHOG_PROXY_HOST=
NEXT_PUBLIC_POSTHOG_KEY=

# === OPTIONAL: AWS (Disabled by default) ===
AWS_SDK_LOAD_CONFIG=0
AWS_REGION=
AWS_S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_POSTGRES_HOST=
# AWS_POSTGRES_PORT=
# AWS_POSTGRES_DB=
# AWS_POSTGRES_USER=
# AWS_POSTGRES_PASSWORD=
