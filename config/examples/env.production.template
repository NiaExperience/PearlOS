# PearlOS Production Environment Template
# Copy to .env.production and fill in values

# === Required: Daily.co (WebRTC voice) ===
DAILY_API_KEY=
DAILY_ROOM_URL=

# === Required: Speech-to-Text ===
DEEPGRAM_API_KEY=

# === Required: LLM ===
ANTHROPIC_API_KEY=
# Or use OpenClaw as proxy:
# OPENCLAW_API_URL=http://localhost:18789/v1
# OPENCLAW_API_KEY=

# === Required: Database ===
MONGODB_URI=mongodb://localhost:27017/pearlos

# === Required: Auth ===
NEXTAUTH_SECRET=change-me-to-random-string
NEXTAUTH_URL=http://localhost:3000

# === Optional: TTS ===
BOT_TTS_PROVIDER=pocket
# Or for ElevenLabs:
# BOT_TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=

# === Optional: OpenClaw (agent backend) ===
# OPENCLAW_API_URL=http://localhost:18789/v1
# OPENCLAW_API_KEY=

# === Feature Flags (all default true) ===
# NEXT_PUBLIC_FEATURE_SUMMON_SPRITE_TOOL=true
# NEXT_PUBLIC_FEATURE_WONDER_CANVAS=true
