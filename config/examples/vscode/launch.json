    "version": "0.2.0",
    "configurations": [

        {
            "name": "Debug Server (pg:debug:servers)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "pg:debug:servers"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "env": {
                "NODE_ENV": "development",
                "NODE_OPTIONS": "--inspect"
            },
            "skipFiles": [
                "<node_internals>/**"
            ],
            "restart": true,
            "autoAttachChildProcesses": true
        },
        {
            "name": "Debug Restart Server (pg:debug:restart-servers)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
