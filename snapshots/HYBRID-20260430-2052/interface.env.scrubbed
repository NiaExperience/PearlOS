# Discord Bot Token for DM feature

# Discord OAuth2 (added 2026-04-28 for the Connect button in Settings → Connections)
# CLIENT_ID is the application/bot ID and is safe to commit.
# (OAuth2 → Client Information → Reset Secret) and the same page must register the redirect URI.
DISCORD_CLIENT_ID=1471496033887322144
DISCORD_OAUTH_REDIRECT_URI=

# Auth bypass flags — keep OFF so real Discord/email auth is enforced.
# Previously TEST_MODE=true was used for screenshot automation; it forced an
# anonymous session on every request and masked broken auth wiring.
TEST_MODE=false

# Anonymous user / voice+text connectivity (merged from .env.dev.local because
# Next.js does not auto-load .env.dev.local — only .env.local and .env.*.local)
NEXT_PUBLIC_TEST_ANONYMOUS_USER=false
BOT_CONTROL_AUTH_REQUIRED=false
BOT_GATEWAY_URL=http://localhost:4444
NEXT_PUBLIC_BOT_CONTROL_BASE_URL=http://localhost:4444

# Google OAuth (added 2026-04-24 for login fix)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_INTERFACE_URL=http://localhost:3000
GOOGLE_INTERFACE_CLIENT_ID=504226522735-vsn3fq8papcsm59ckirkgd6i09bsto79.apps.googleusercontent.com

# YouTube Data API v3 key (server-side, used by /api/youtube-search).
# Restored 2026-04-28: was lost during the 2026-04-27 .env.local rewrite for
# the OAuth fix. Without it, the route falls back to public Invidious mirrors,
# all of which are now offline (502 / refused / 301-to-error), so YouTube
# search returns 500 and the player shows "Unable to load video".
