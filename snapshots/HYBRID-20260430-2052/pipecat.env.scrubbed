# Daily Pipecat Bot Configuration
# Copy this content to a .env file and fill in your actual values

# Redis Configuration (optional - disabled by default for simpler local dev)
# When USE_REDIS=false, the gateway calls the runner directly (no queue)
USE_REDIS=false
# REDIS_URL=redis://localhost:6379

# Auto-join default room on startup (disabled to prevent room mismatch bug)
# When false, bot only joins rooms when UI explicitly requests via POST /join
AUTO_ROOM_ENABLED=false

# Daily API key for token generation (get from https://dashboard.daily.co)

# Your Daily room URL to connect to
DAILY_ROOM_URL="https://pearlos.daily.co/sUdXUVtuT0HFbSQRvdsE"

# OpenAI API key removed — all LLM calls route through OpenRouter or OpenClaw Gateway

# OpenRouter API key for uncensored models (Hermes 4, Dolphin, etc.)
# OpenRouter enabled for Gemini Flash voice model
OPENROUTER_ENABLED=true

# Groq API key for Llama 4 Scout / Llama 3.3 70B (fast inference via LPU)
# GROQ API key for fast voice model

# MiniMax API key for M2.5 (80.2% SWE-Bench, 100 TPS, tool-calling optimized)
# Get your key at: https://platform.minimax.io

# ============ A/B Testing: Model Selection ============
# Switch between models for testing latency and quality
# Options: gpt-4o-mini | llama-4-scout | llama-3.3-70b | hermes-4-70b | minimax-m2.5
# Options: haiku | llama-4-scout | llama-3.3-70b | gpt-4o-mini | deepseek-chat
# BOT_MODEL_SELECTION not used in openclaw_session mode
# BOT_MODEL_SELECTION=ollama
# OLLAMA_VOICE_MODEL=qwen3-fast
# OLLAMA_BASE_URL=http://127.0.0.1:11435/v1

# Mesh API endpoint (for fetching personality config from database)
MESH_API_ENDPOINT=http://localhost:2000/api

# Text-to-Speech provider configuration
# Options: pocket, kokoro, voxtral
BOT_TTS_PROVIDER=pocket  # Voice channel default; PocketTTS responds in ~1ms vs Voxtral 3-8s. Frontend voiceProvider can still override per-request via bot.py:87.

# Voxtral TTS settings (BOT_TTS_PROVIDER=voxtral) — served by Pod 2 via SSH tunnel on :18100
VOXTRAL_TTS_BASE_URL=https://api.mistral.ai
VOXTRAL_TTS_MODEL=voxtral-mini-tts-2603
VOXTRAL_TTS_VOICE=gb_jane_neutral
VOXTRAL_TTS_SPEED=1.0
VOXTRAL_TTS_RESPONSE_FORMAT=wav

# Kokoro / Chorus credentials (used when BOT_TTS_PROVIDER=kokoro)
# For local Chorus TTS (default), API key is optional - will auto-use "test-key" if not set
# Base websocket URL for Kokoro (local Chorus runs on ws://127.0.0.1:8765)
# NOTE: Changed from 8000 to 8765 to avoid conflict with OpenClaw Gateway on port 8000
KOKORO_TTS_BASE_URL=ws://127.0.0.1:8765
# Default Kokoro voice id (matches selections exposed in the dashboard)
KOKORO_TTS_VOICE_ID=af_heart

# ============================================================
# MODEL CONFIGURATION
# ============================================================
# Primary voice model is controlled by openclaw.json → agents.list[voice].model.primary
# Change it there, via /model command, or via Pearl Mind settings UI.
# BOT_OPENCLAW_AGENT determines which OpenClaw agent the voice bot targets.
# ============================================================
BOT_OPENCLAW_AGENT=openclaw:voice

# ============ OpenClaw Bridge Configuration ============
# Bridge server for OpenClaw integration (HTTP/SSE, not WebSocket)
OPENCLAW_BRIDGE_URL=http://localhost:3100
# OpenClaw Gateway (HTTP API for chat completions)
OPENCLAW_API_URL=http://localhost:18789/v1
BOT_USE_SONNET_PRIMARY=false
BOT_SONNET_MODEL=openclaw/voice

# Anthropic API key (for native Haiku mode)
# COMMENTED OUT: Using setup-token via OpenClaw gateway instead
# Anthropic API key — enables direct Haiku bypass for Phase 1 voice (skips OpenClaw gateway)

# Model for bot_think_deeply escalation (complex reasoning)
# Options: anthropic/claude-opus-4.6, anthropic/claude-sonnet-4.5, deepseek/deepseek-chat
# Defaults to Opus if not specified
BOT_ESCALATION_MODEL=anthropic/claude-opus-4-6

# Timeout for bot_think_deeply calls (seconds)
BOT_ESCALATION_TIMEOUT=45

# OpenClaw workspace path (for cross-session memory files)
OPENCLAW_WORKSPACE=/root/.openclaw/workspace
# TTS speed multiplier (1.2 = 20% faster)
POCKET_TTS_SPEED=1.0

# YouTube API
# Bumped from 30s -> 120s 2026-04-30: webchat users frequently pause before
# speaking, and the 30s idle timeout was the dominant cause of pipecat-runner
# restart thrash (260 restarts / 15h). New default lives in core/config.py.
BOT_EMPTY_INITIAL_SECS=120

# Minimum gap between consecutive _launch_session calls. Prevents overlapping
# LLM/voice connections from competing for GPU under retry storms or rapid
# reloads. 0 disables the gate.
BOT_SPAWN_COOLDOWN_SECS=10

DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
BOT_SESSION_USER_ID=anonymous
# Options: openclaw_session | sonnet | haiku | anthropic | hybrid | sonnet_primary
# openclaw_session = OpenClaw handles ALL reasoning, PearlOS is voice+UI only
# Hybrid mode is fast but braindead (no Pearl identity/tools/workspace)
# openclaw_session gives Pearl her brain - model speed controlled by voice agent in openclaw.json
# openclaw_session: all voice through OpenClaw (Haiku voice agent, full Pearl brain+tools)
BOT_LLM_MODE=
# BOT_LLM_MODE=anthropic  # CRASHES - AnthropicLLMService not available
BOT_NON_BLOCKING_TOOLS=true

# Fast model for non-blocking voice acknowledgments while tools run
# BOT_FAST_MODEL=llama-3.1-8b
# Previous Groq config:
# BOT_FAST_MODEL=groq/llama-3.3-70b-versatile
BOT_FAST_MODEL=deepseek-v4-flash

# Per-role model overrides (set via Pearl Mind settings panel)
# Leave empty to use defaults. The model-settings API fills these when user selects.
# BOT_VOICE_MODEL is read by /api/model-preference?channel=voice and forwarded
# to OpenClaw as x-openclaw-model-override. This is what actually routes voice.
BOT_VOICE_MODEL=
BOT_LLM_MODEL=deepseek-v4-flash
BOT_TOOLS_MODEL=deepseek-v4-flash
BOT_SWARM_MODEL=pearl-llm/deepseek-v4-flash
BOT_THINKING_MODEL=pearl-llm/deepseek-v4-flash
BOT_VISION_MODEL=openai/gpt-4o-mini
# Default Pearl personality (added by pre-test setup)
BOT_PERSONALITY_RECORD='{"_id":"pearl-default","name":"Pearl","primaryPrompt":"You are Pearl, a helpful and friendly AI assistant. You are warm, empathetic, and conversational. Keep responses concise for voice (1-3 sentences). You have a playful personality and care about the user.","voiceProvider":"voxtral","voiceId":"casual_female"}'

BOT_HYBRID_MODEL=deepseek-v4-flash
BOT_VISION_ENABLED=true
BOT_HYBRID_BASE_URL=http://localhost:8200/v1
# Voice compact tools: consolidate ~70 tools into ~8 super tools for lower latency
BOT_VOICE_COMPACT_TOOLS=true

# Subconscious Model - fast tool router (GPT-4o-mini via OpenRouter)
BOT_SUBCONSCIOUS_MODEL=openai/gpt-4o-mini
BOT_SUBCONSCIOUS_BASE_URL=https://openrouter.ai/api/v1

# Voxtral TTS settings (disabled — requires 19GB GPU VRAM, not feasible for MacBook)
# VOXTRAL_TTS_URL=http://localhost:8100
# VOXTRAL_TTS_VOICE=gb_jane_sarcasm
# VOXTRAL_TTS_SPEED=1.0
# VOXTRAL_TTS_GAIN=2.0

# Bot gateway self-reference URL (for internal API calls like model-preference)
BOT_GATEWAY_URL=http://localhost:4444

# Bot control auth — shared secret with interface for /join etc. Set to disabled
# for local dev so interface can call the gateway without signing requests.
BOT_CONTROL_AUTH_REQUIRED=false
OLLAMA_KEEP_ALIVE=-1
DEEPSEEK_BASE_URL=http://127.0.0.1:8200/v1
BOT_FAST_API_URL=http://localhost:8200/v1

# PulseAudio for headless Daily.co audio input
PULSE_SERVER=/tmp/pulse-stable/native

# OpenClaw web chat timeouts
# sock_read = inter-chunk gap. Tool calls (web fetch, sub-agent dispatch,
# canvas render) can stall the SSE stream for 60-90s before OpenClaw emits
# the next chunk. 15s aborted webchat tool calls mid-execution; 120s gives
# the agent loop room to finish a tool while still detecting a dead upstream.
CHAT_OPENCLAW_READ_GAP_SECS=120
# total budget for the entire chat completion (covers multi-turn tool use)
CHAT_OPENCLAW_TIMEOUT_SECS=300
# ASK-PEARL widget budget (was hard-coded 12s, far too tight for tool replies)
ASK_PEARL_OPENCLAW_TIMEOUT_SECS=180
